<?xml version="1.0"?>
<model>
  <name>ENPH479 boat</name>
  <version>1.0</version>
  <description>
    Meshes for the ENPH479 catamaran (SolidWorks export). The robot itself is defined in
    boat_gazebo/urdf/enph479_boat.xacro; this folder only makes the meshes reachable as
    model://enph479_boat/meshes/...
  </description>
</model>
